# ------------------------------------------------------------------
# Partners in Literacy Haiti — environment variables
# Copy to .env.local for local dev, or set in Vercel project settings.
# Every variable is OPTIONAL. The site works with none of them set;
# each one simply switches on an extra capability.
# ------------------------------------------------------------------

# Canonical site URL used in sitemap, hreflang and structured data.
NEXT_PUBLIC_SITE_URL=https://www.haiti-literacy.org

# Sèvitè PILH, the AI concierge. Without a key the chat shows a polite
# offline message pointing to email. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-haiku-4-5 (fast and cheap).
CONCIERGE_MODEL=

# Contact form and newsletter delivery by email, via resend.com.
# Free tier covers a small nonprofit easily.
RESEND_API_KEY=
LEAD_TO_EMAIL=administrator@haiti-literacy.org
LEAD_FROM_EMAIL=website@haiti-literacy.org

# Optional webhook for leads (Zapier, Make, Slack incoming webhook).
# Fires in addition to email when set.
LEAD_WEBHOOK_URL=
